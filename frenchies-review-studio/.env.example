# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# Get a key at https://console.anthropic.com/ (Settings → API Keys).

# You can set keys here OR add them in the app under "API keys" (stored locally
# in a git-ignored .secrets.json). Either way, keys stay server-side and are
# never sent to the browser. Keys added in the UI take precedence over these.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (GPT) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Google (Gemini) ---
# GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-1.5-flash

# --- OpenAI-compatible (OpenRouter, Groq, DeepSeek, local, …) ---
# Configure this one in the UI (it needs a base URL). Example env alternative:
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Server ---
PORT=3000

# Optional base-URL overrides (self-host / proxy / testing):
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
