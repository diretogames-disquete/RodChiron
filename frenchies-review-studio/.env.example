# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# Get a key at https://console.anthropic.com/ (Settings → API Keys).

# Required — your Anthropic API key. Stays server-side; never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — the model to use. Defaults to the current Sonnet-class model.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — port for the local server (default 3000).
PORT=3000

# Optional — override the API base URL (for self-host/proxy/testing).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
